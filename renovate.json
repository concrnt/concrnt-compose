{
  "requiredStatusChecks": null,
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "world-app is released as YYYY.MDD.N (e.g. 2026.1120.0). A new year is a major bump only by numbering, so every update is automerged.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/concrnt/world-app"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
